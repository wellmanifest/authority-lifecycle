{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/authority-lifecycle/v1",
  "title": "Wellmanifest Authority Lifecycle",
  "oneOf": [
    {"$ref": "#/$defs/grant"},
    {"$ref": "#/$defs/profile"}
  ],
  "$defs": {
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "kind"],
      "properties": {
        "uri": {"type": "string", "pattern": "^authority://principal/[a-z0-9][a-z0-9._/-]*$"},
        "kind": {"enum": ["protected-authority", "agent", "service", "human"]}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "actor", "at", "subjectDigest"],
      "properties": {
        "receiptId": {"type": "string", "pattern": "^authority://receipt/[a-z0-9][a-z0-9._/-]*$"},
        "actor": {"$ref": "#/$defs/principal"},
        "at": {"type": "string", "format": "date-time"},
        "subjectDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason", "receipt"],
      "properties": {
        "from": {"type": ["string", "null"], "enum": [null, "issued", "active", "suspended", "revoked", "expired", "exhausted"]},
        "to": {"enum": ["issued", "active", "suspended", "revoked", "expired", "exhausted"]},
        "reason": {"type": "string", "minLength": 3, "maxLength": 240},
        "receipt": {"$ref": "#/$defs/receipt"}
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "grantId", "revision", "state", "issuer", "subject", "policyDigest", "scope", "budgets", "validity", "renewal", "lease", "history"],
      "properties": {
        "schema": {"const": "wellmanifest.authority/grant/v1"},
        "grantId": {"type": "string", "pattern": "^authority://grant/[a-z0-9][a-z0-9._/-]*$"},
        "revision": {"type": "integer", "minimum": 1},
        "state": {"enum": ["issued", "active", "suspended", "revoked", "expired", "exhausted"]},
        "issuer": {"$ref": "#/$defs/principal"},
        "subject": {"$ref": "#/$defs/principal"},
        "policyDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "scope": {
          "type": "object", "additionalProperties": false,
          "required": ["capabilities", "resources", "allowedEffects", "deniedEffects"],
          "properties": {
            "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^subactor://capability/[a-z0-9][a-z0-9._/-]*$"}},
            "resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://[^ ]+$"}},
            "allowedEffects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"}},
            "deniedEffects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"}}
          }
        },
        "budgets": {
          "type": "object", "additionalProperties": false,
          "required": ["maxUses", "maxConcurrent", "maxCostMinor"],
          "properties": {
            "maxUses": {"type": "integer", "minimum": 1},
            "maxConcurrent": {"type": "integer", "minimum": 1},
            "maxCostMinor": {"type": "integer", "minimum": 0}
          }
        },
        "validity": {
          "type": "object", "additionalProperties": false,
          "required": ["notBefore", "expiresAt"],
          "properties": {
            "notBefore": {"type": "string", "format": "date-time"},
            "expiresAt": {"type": "string", "format": "date-time"}
          }
        },
        "renewal": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "issuer", "maxRenewals", "priorGrantDigestRequired"],
          "properties": {
            "mode": {"const": "external-only"},
            "issuer": {"$ref": "#/$defs/principal"},
            "maxRenewals": {"type": "integer", "minimum": 0},
            "priorGrantDigestRequired": {"const": true}
          }
        },
        "lease": {
          "type": "object", "additionalProperties": false,
          "required": ["required", "leaseId", "owner", "epoch", "acquiredAt", "expiresAt"],
          "properties": {
            "required": {"const": true},
            "leaseId": {"type": "string", "pattern": "^authority://lease/[a-z0-9][a-z0-9._/-]*$"},
            "owner": {"$ref": "#/$defs/principal"},
            "epoch": {"type": "integer", "minimum": 1},
            "acquiredAt": {"type": "string", "format": "date-time"},
            "expiresAt": {"type": "string", "format": "date-time"}
          }
        },
        "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transition"}}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "uri", "principal", "mode"],
      "properties": {
        "stage": {"enum": ["issue", "evaluate", "lease", "execute", "revoke", "audit"]},
        "uri": {"type": "string", "pattern": "^subactor://process/[a-z0-9][a-z0-9._/-]*$"},
        "principal": {"$ref": "#/$defs/principal"},
        "mode": {"enum": ["protected-write", "read-only", "consume-only", "append-only"]}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "profileId", "version", "ownership", "bindings"],
      "properties": {
        "schema": {"const": "wellmanifest.authority/profile/v1"},
        "profileId": {"type": "string", "pattern": "^authority://profile/[a-z0-9][a-z0-9._/-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "ownership": {
          "type": "object", "additionalProperties": false,
          "required": ["standardOwner", "runtimeOwner", "adopts"],
          "properties": {
            "standardOwner": {"const": "wellmanifest/authority-lifecycle"},
            "runtimeOwner": {"type": "string", "pattern": "^(subactor|semcod)/[a-z0-9][a-z0-9._/-]*$"},
            "adopts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^wellmanifest/[a-z0-9][a-z0-9._/-]*$"}}
          }
        },
        "bindings": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/binding"}}
      }
    }
  }
}
